---
// 绘本卡片：整卡链接到详情页（理由/ISBN/来源/外链都在详情页）
import taxonomy from '../data/taxonomy.json';
const ageLabel = Object.fromEntries(taxonomy.age_bands.map((t) => [t.id, t.label]));
const langLabel = Object.fromEntries(taxonomy.languages.map((t) => [t.id, t.label]));
const themeLabel = Object.fromEntries(taxonomy.book_themes.map((t) => [t.id, t.label]));

interface Props {
	book: any;
}
const { book: b } = Astro.props;
import { base, assetUrl } from '../lib/base.ts';
const href = `${base}book/${b.id}/`;
const coverSrc = assetUrl(b.cover);
---
<a class="bkcard" href={href}>
	<div class="bkcover">
		{coverSrc && <img src={coverSrc} loading="lazy" alt="" onerror="this.style.display='none'" />}
		{b.rating && <span class="bkrating">★ {b.rating}</span>}
	</div>
	<div class="bkbody">
		<h2 class="bktitle">{b.title}</h2>
		{b.title_en && <div class="bktitle-en">{b.title_en}</div>}
		{b.author && <div class="bkauthor">{b.author}</div>}
		<div class="tagrow">
			{b.tags.age.map((a) => <span class="tag" data-tag={a} data-tag-dim="age">{ageLabel[a] ?? a}</span>)}
			{b.tags.language.map((l) => <span class="tag" data-tag={l} data-tag-dim="language">{langLabel[l] ?? l}</span>)}
			{b.tags.theme.map((t) => <span class="tag" data-tag={t} data-tag-dim="book_theme">{themeLabel[t] ?? t}</span>)}
		</div>
	</div>
</a>

<style>
	.bkcard {
		background: var(--card); border-radius: var(--radius); overflow: hidden;
		box-shadow: var(--shadow);
		display: flex; flex-direction: column;
		text-decoration: none; color: inherit;
	}
	.bkcard:hover .bktitle { color: var(--sea); }
	.bkcover {
		position: relative; aspect-ratio: 4 / 5; background: var(--placeholder);
		display: grid; place-items: center;
	}
	.bkcover img {
		position: absolute; inset: 0; width: 100%; height: 100%;
		object-fit: contain; padding: 0.5rem;
	}
	.bkrating {
		position: absolute; left: 6px; top: 6px; z-index: 1;
		font-size: 0.75rem; font-weight: 700; color: var(--warm-ink);
		background: rgba(255, 251, 235, 0.95); padding: 0.1rem 0.45rem; border-radius: 6px;
	}
	.bkbody { padding: 0.7rem 0.9rem 0.9rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
	.bktitle {
		margin: 0; font-size: 0.95rem; font-weight: 600; line-height: 1.4;
		display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
	}
	.bktitle-en { font-size: 0.75rem; color: var(--muted); margin-top: -0.3rem; }
	.bkauthor { font-size: 0.78rem; color: var(--muted); }
</style>
