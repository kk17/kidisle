---
import { pageBase, langOf } from '../lib/base.ts';
// 视频卡片：整卡链接到观看页
import taxonomy from '../data/taxonomy.json';
const ageLabel = Object.fromEntries(taxonomy.age_bands.map((t) => [t.id, t.label]));
const langLabel = Object.fromEntries(taxonomy.languages.map((t) => [t.id, t.label]));
const themeLabel = Object.fromEntries(taxonomy.themes.map((t) => [t.id, t.label]));

interface Props {
	video: any;
	compact?: boolean;
}
const { video: v, compact = false } = Astro.props;
import { base } from '../lib/base.ts';
const isYT = v.source === 'youtube';
const lb = pageBase(langOf(Astro.url.pathname)); // 站内链接带当前语言前缀（RIGE-1080）
const href = `${lb}video/${v.source === 'youtube' ? v.vid : v.bvid}/`;
const pad = (n: number) => String(n).padStart(2, '0');
const dur = v.duration_seconds > 0
	? v.duration_seconds >= 3600
		? `${Math.floor(v.duration_seconds / 3600)}:${pad(Math.floor((v.duration_seconds % 3600) / 60))}:${pad(v.duration_seconds % 60)}`
		: `${Math.floor(v.duration_seconds / 60)}:${pad(v.duration_seconds % 60)}`
	: '';
---
<a class={`vcard${compact ? ' compact' : ''}`} href={href}>
	<span class="vcover">
		{v.cover && <img src={v.cover} loading="lazy" referrerpolicy="no-referrer" alt="" />}
		{dur && <span class="vdur">{dur}</span>}
	</span>
	<span class="vbody">
		<span class="vtitle">{isYT ? (
			<svg class="vsrc" viewBox="0 0 24 24" role="img" aria-label="YouTube"><title>YouTube</title><rect x="1" y="4.5" width="22" height="15" rx="4.5" fill="#ff0033"/><path d="M10 8.6v6.8l5.8-3.4z" fill="#fff"/></svg>
		) : (
			<svg class="vsrc" viewBox="0 0 24 24" role="img" aria-label="B站 / Bilibili"><title>B站 / Bilibili</title><path d="M7.2 2.6l2.6 2.6M16.8 2.6l-2.6 2.6" stroke="#00a1d6" stroke-width="1.9" stroke-linecap="round"/><rect x="1.5" y="5.4" width="21" height="15.6" rx="4" fill="#00a1d6"/><rect x="4.2" y="8.1" width="15.6" height="10.2" rx="2.2" fill="#fff"/><path d="M8 11.4l2.2 1M16 11.4l-2.2 1" stroke="#00a1d6" stroke-width="1.7" stroke-linecap="round"/></svg>
		)}{v.title}</span>
		{!compact && <span class="vup">{v.up}</span>}
		<span class="vtagrow">
			{v.tags.age.map((a) => <span class="tag" data-tag={a} data-tag-dim="age">{ageLabel[a] ?? a}</span>)}
			{v.tags.language.map((l) => <span class="tag" data-tag={l} data-tag-dim="language">{langLabel[l] ?? l}</span>)}
			{v.tags.theme.map((t) => <span class="tag" data-tag={t} data-tag-dim="theme">{themeLabel[t] ?? t}</span>)}
		</span>
	</span>
</a>

<style>
	.vcard {
		display: flex; flex-direction: column; text-decoration: none; color: inherit;
		background: var(--card); border-radius: var(--radius); overflow: hidden;
		box-shadow: var(--shadow);
	}
	.vcard:hover .vtitle { color: var(--sea); }
	.vcover {
		position: relative; display: block; aspect-ratio: 16 / 9; background: var(--placeholder);
	}
	.vcover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	/* 来源图标：标题第一个字符位置，不再压在封面左上角（RIGE-1073） */
	.vsrc {
		display: inline-block; width: 1.15em; height: 1.15em; vertical-align: -0.2em;
		margin-right: 0.3em; flex-shrink: 0;
	}
	.vdur {
		position: absolute; right: 6px; bottom: 6px;
		font-size: 0.72rem; color: #fff; background: rgba(0, 0, 0, 0.72);
		padding: 0.05rem 0.4rem; border-radius: 5px;
	}
	.vbody { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.65rem 0.85rem 0.85rem; }
	.vtitle {
		font-size: 0.92rem; font-weight: 600; line-height: 1.4;
		display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
	}
	.vup { font-size: 0.78rem; color: var(--muted); }
	.vtagrow { display: flex; flex-wrap: wrap; gap: 0.28rem; }
	.compact { flex-direction: row; }
	.compact .vcover { width: 168px; flex-shrink: 0; aspect-ratio: 16 / 9; position: relative; }
	.compact .vbody { padding: 0.5rem 0.7rem; }
</style>
