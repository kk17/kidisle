---
// 根路径重定向（RIGE-1021 URL 统一）：GitHub Pages 无服务端重写，
// 用 meta refresh + JS 兜底跳到视频片单 /videos/；canonical 指向目标页避免双收录。
import { base } from '../lib/base.ts';
const target = `${base}videos/`;
const canonical = Astro.site ? new URL(target, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<title>童心湾 · 精选儿童视频与绘本</title>
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
	</head>
	<body>
		<script is:inline set:html={`location.replace(${JSON.stringify(target)});`} />
		<p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
			<a href={target}>进入视频片单 →</a>
		</p>
	</body>
</html>
