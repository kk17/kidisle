---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import BookCard from '../components/BookCard.astro';
import taxonomy from '../data/taxonomy.json';
import videos from '../data/videos.json';
import books from '../data/books.json';

const ageBands = taxonomy.age_bands;
const languages = taxonomy.languages;
const themes = taxonomy.themes;
---
<Base>
	<div class="modebar">
		<label for="datatype" data-i18n="datatype_label">数据类型</label>
		<select id="datatype">
			<option value="video" data-i18n="mode_video">视频片单</option>
			<option value="book" data-i18n="mode_book">绘本书单</option>
		</select>
	</div>

	<section class="filters" id="video-filters">
		<div class="filter-row">
			<span class="dim" data-i18n="filter_platform">平台</span>
			<div class="options">
				<button class="chip" data-dim="platform" data-v="bilibili" data-tag="bilibili" data-tag-dim="platform" aria-pressed="false">B站</button>
				<button class="chip" data-dim="platform" data-v="youtube" data-tag="youtube" data-tag-dim="platform" aria-pressed="false">YouTube</button>
				<button class="chip" id="plat-all" aria-pressed="true" data-i18n="all">全部</button>
			</div>
		</div>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_age">年龄段</span>
			<div class="options">
				{ageBands.map((t) => <button class="chip" data-dim="age" data-v={t.id} data-tag={t.id} data-tag-dim="age" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-clear="age" data-i18n="clear">清空</button>
				<span class="count" id="count"></span>
			</div>
		</div>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_language">语言</span>
			<div class="options">
				{languages.map((t) => <button class="chip" data-dim="language" data-v={t.id} data-tag={t.id} data-tag-dim="language" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-clear="language" data-i18n="clear">清空</button>
			</div>
		</div>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_theme">主题</span>
			<div class="options">
				{themes.map((t) => <button class="chip" data-dim="theme" data-v={t.id} data-tag={t.id} data-tag-dim="theme" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-clear="theme" data-i18n="clear">清空</button>
			</div>
		</div>
	</section>

	<section class="filters" id="book-filters" hidden>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_age">年龄段</span>
			<div class="options">
				{ageBands.map((t) => <button class="chip" data-bdim="age" data-v={t.id} data-tag={t.id} data-tag-dim="age" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-bclear="age" data-i18n="clear">清空</button>
				<span class="count" id="book-count"></span>
			</div>
		</div>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_language">语言</span>
			<div class="options">
				{languages.map((t) => <button class="chip" data-bdim="language" data-v={t.id} data-tag={t.id} data-tag-dim="language" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-bclear="language" data-i18n="clear">清空</button>
			</div>
		</div>
		<div class="filter-row">
			<span class="dim" data-i18n="filter_theme">主题</span>
			<div class="options">
				{themes.map((t) => <button class="chip" data-bdim="theme" data-v={t.id} data-tag={t.id} data-tag-dim="theme" aria-pressed="false">{t.label}</button>)}
				<button class="chip-clear" data-bclear="theme" data-i18n="clear">清空</button>
			</div>
		</div>
	</section>

	<main>
		<div id="video-section">
			<ul class="grid" id="grid" style="list-style:none">
				{
					videos.videos.map((v) => (
						<li
							class="cell"
							data-platform={v.source}
							data-age={JSON.stringify(v.tags.age)}
							data-language={JSON.stringify(v.tags.language)}
							data-theme={JSON.stringify(v.tags.theme)}
						>
							<VideoCard video={v} />
						</li>
					))
				}
			</ul>
			<div class="empty" id="empty" hidden data-i18n="empty_home">这个组合下暂时没有视频，换个筛选试试～</div>
		</div>

		<div id="book-section" hidden>
			<ul class="grid bgrid" id="book-grid" style="list-style:none">
				{
					books.books.map((b) => (
						<li
							class="bookcell"
							data-age={JSON.stringify(b.tags.age)}
							data-language={JSON.stringify(b.tags.language)}
							data-theme={JSON.stringify(b.tags.theme)}
						>
							<BookCard book={b} />
						</li>
					))
				}
			</ul>
			<div class="empty" id="book-empty" hidden data-i18n="empty_books">这个组合下暂时没有绘本，换个筛选试试～</div>
		</div>
	</main>

	<style>
		.modebar {
			max-width: var(--maxw); margin: 0 auto; padding: 0.9rem 1rem 0;
			display: flex; align-items: center; gap: 0.6rem;
		}
		.modebar label { font-size: 0.85rem; color: var(--muted); }
		.modebar select {
			font-size: 0.9rem; font-weight: 600; padding: 0.35rem 2rem 0.35rem 0.8rem;
			border: 1px solid var(--line); border-radius: 10px;
			background: var(--card) url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%230284c7' stroke-width='1.5' fill='none' stroke-linecap='round'/%3E%3C/svg%3E") no-repeat right 0.6rem center;
			color: var(--ink); cursor: pointer; appearance: none;
		}
		.filters[hidden] { display: none; }
		.filters {
			position: sticky; top: 52px; z-index: 10;
			background: rgba(240, 249, 255, 0.92); backdrop-filter: blur(6px);
			border-bottom: 1px solid var(--line);
			padding: 0.6rem 1rem;
			display: flex; flex-direction: column; gap: 0.4rem;
			max-width: var(--maxw); margin: 0 auto;
		}
		/* 每个筛选维度占一行：标签按内容自适应宽度（英文长词不溢出），选项在其右侧换行 */
		.filter-row { display: flex; align-items: flex-start; gap: 0.5rem; }
		.filter-row .dim {
			font-size: 0.78rem; color: var(--muted);
			white-space: nowrap; flex: 0 0 auto;
			min-width: 3.2em; padding-top: 0.28rem;
		}
		.filter-row .options {
			display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
			flex: 1 1 auto; min-width: 0;
		}
		.filter-row .count { margin-left: auto; }
		.chip {
			font-size: 0.82rem; padding: 0.26rem 0.8rem; border-radius: 999px;
			border: 1px solid var(--line); background: var(--card); color: var(--ink);
			cursor: pointer; user-select: none;
		}
		.chip[aria-pressed='true'] { background: var(--sea); border-color: var(--sea); color: #fff; }
		.chip-clear {
			font-size: 0.78rem; color: var(--sea); background: none; border: none;
			cursor: pointer; text-decoration: underline;
		}
		.count { font-size: 0.8rem; color: var(--muted); margin-left: auto; }
		.grid {
			margin: 0 auto; padding: 1rem 1rem 3rem; max-width: var(--maxw);
			display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;
		}
		.bgrid { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
		.empty { text-align: center; color: var(--muted); padding: 3rem 1rem; }
	</style>

	<script>
		// ---- 模式切换：视频 / 图书 ----
		const modeSel = document.getElementById('datatype') as HTMLSelectElement;
		const videoFilters = document.getElementById('video-filters')!;
		const bookFilters = document.getElementById('book-filters')!;
		const videoSection = document.getElementById('video-section')!;
		const bookSection = document.getElementById('book-section')!;

		modeSel.addEventListener('change', () => {
			const mode = modeSel.value;
			videoFilters.hidden = mode !== 'video';
			bookFilters.hidden = mode !== 'book';
			videoSection.hidden = mode !== 'video';
			bookSection.hidden = mode !== 'book';
		});

		// ---- 视频筛选 ----
		const state: Record<string, Set<string>> = {
			platform: new Set(),
			age: new Set(),
			language: new Set(),
			theme: new Set(),
		};
		const platAllBtn = document.getElementById('plat-all')!;
		function syncPlatAll() {
			platAllBtn.setAttribute('aria-pressed', String(state.platform.size === 0));
		}
		const cells = Array.from(document.querySelectorAll<HTMLLIElement>('.cell'));
		const countEl = document.getElementById('count')!;
		const emptyEl = document.getElementById('empty')!;

		function apply() {
			let shown = 0;
			for (const cell of cells) {
				const ok = (['age', 'language', 'theme'] as const).every((dim) => {
						if (state[dim].size === 0) return true;
						const vals: string[] = JSON.parse(cell.dataset[dim] || '[]');
						return vals.some((v) => state[dim].has(v));
					}) && (state.platform.size === 0 || state.platform.has(cell.dataset.platform));
				cell.style.display = ok ? '' : 'none';
				if (ok) shown++;
			}
			countEl.textContent = `${shown} / ${cells.length}`;
			emptyEl.hidden = shown > 0;
		}
		document.querySelectorAll<HTMLButtonElement>('.chip[data-dim]').forEach((chip) => {
			if (chip.id === 'plat-all') {
				chip.addEventListener('click', () => {
					state.platform.clear();
					document.querySelectorAll<HTMLButtonElement>('.chip[data-dim="platform"]').forEach((c) => c.setAttribute('aria-pressed', 'false'));
					syncPlatAll();
					apply();
				});
				return;
			}
			chip.addEventListener('click', () => {
				const set = state[chip.dataset.dim!];
				const v = chip.dataset.v!;
				if (set.has(v)) { set.delete(v); chip.setAttribute('aria-pressed', 'false'); }
				else { set.add(v); chip.setAttribute('aria-pressed', 'true'); }
				syncPlatAll();
				apply();
			});
		});
		document.querySelectorAll<HTMLButtonElement>('.chip-clear[data-clear]').forEach((btn) => {
			btn.addEventListener('click', () => {
				state[btn.dataset.clear!].clear();
				document.querySelectorAll<HTMLButtonElement>(`.chip[data-dim="${btn.dataset.clear}"]`).forEach((c) => c.setAttribute('aria-pressed', 'false'));
				apply();
			});
		});
		apply();

		// ---- 图书筛选（与视频筛选独立的 state）----
		const bstate: Record<string, Set<string>> = { age: new Set(), language: new Set(), theme: new Set() };
		const bookCells = Array.from(document.querySelectorAll<HTMLElement>('.bookcell'));
		const bookCountEl = document.getElementById('book-count')!;
		const bookEmptyEl = document.getElementById('book-empty')!;

		function applyBooks() {
			let shown = 0;
			for (const cell of bookCells) {
				const ok = (['age', 'language', 'theme'] as const).every((dim) => {
					if (bstate[dim].size === 0) return true;
					const vals: string[] = JSON.parse(cell.dataset[dim] || '[]');
					return vals.some((v) => bstate[dim].has(v));
				});
				cell.style.display = ok ? '' : 'none';
				if (ok) shown++;
			}
			bookCountEl.textContent = `${shown} / ${bookCells.length}`;
			bookEmptyEl.hidden = shown > 0;
		}
		document.querySelectorAll<HTMLButtonElement>('.chip[data-bdim]').forEach((chip) => {
			chip.addEventListener('click', () => {
				const set = bstate[chip.dataset.bdim!];
				const v = chip.dataset.v!;
				if (set.has(v)) { set.delete(v); chip.setAttribute('aria-pressed', 'false'); }
				else { set.add(v); chip.setAttribute('aria-pressed', 'true'); }
				applyBooks();
			});
		});
		document.querySelectorAll<HTMLButtonElement>('.chip-clear[data-bclear]').forEach((btn) => {
			btn.addEventListener('click', () => {
				bstate[btn.dataset.bclear!].clear();
				document.querySelectorAll<HTMLButtonElement>(`.chip[data-bdim="${btn.dataset.bclear}"]`).forEach((c) => c.setAttribute('aria-pressed', 'false'));
				applyBooks();
			});
		});
		applyBooks();
	</script>
</Base>
